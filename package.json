{
  "name": "dsh-mission-control",
  "version": "0.1.0",
  "description": "Secretary + Commander + Workers: a three-tier agent command mode with a live Mission Control panel for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "multi-agent",
    "orchestration",
    "mission-control",
    "subagent"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check lib/pure.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
